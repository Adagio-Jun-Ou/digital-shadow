  ],
  "base_url": "https://your-host.your-tailnet.ts.net:8766",
  "authentication": {
    "type": "X-API-Key",
    "header": "X-API-Key",
    "required": false,
    "env_var": "SHADOW_OS_API_KEY"
  },
  "api_endpoints": {
    "device_register": {
      "method": "POST",
      "path": "/os/device/register",
      "description": "Register a new device"
    },
    "iphone_ingest": {
      "method": "POST",
      "path": "/os/device/iphone",
      "description": "Push iPhone data (health, location, battery, notifications)"
    },
    "watch_ingest": {
      "method": "POST",
      "path": "/os/device/watch",
      "description": "Push Apple Watch health data (HR, HRV, SpO2, steps)"
    },
    "laptop_ingest": {
      "method": "POST",
      "path": "/os/device/laptop",
      "description": "Push laptop data (active window, CPU, battery, WiFi)"
    },
    "device_context": {
      "method": "GET",
      "path": "/os/device/context",
      "description": "Get current unified device context"
    },
    "health_trends": {
      "method": "GET",
      "path": "/os/device/health-trends",
      "description": "Get health data trends"
    },
    "digital_wellbeing": {
      "method": "GET",
      "path": "/os/device/digital-wellbeing",
      "description": "Get digital wellbeing metrics"
    }
  },
  "data_schemas": {
    "iphone": {
      "health": {
        "heart_rate": "number (bpm)",
        "hrv": "number (ms, heart rate variability)",
        "steps": "number (daily step count)",
        "sleep_hours": "number (hours slept last night)",
        "spo2": "number (blood oxygen %)",
        "stress_level": "string (low/medium/high)",
        "active_energy": "number (kcal burned)"
      },
      "location": {
        "latitude": "number",
        "longitude": "number",
        "accuracy": "number (meters)",
        "name": "string (place name)"
      },
      "battery": {
        "level": "number (0-100)",
        "charging": "boolean"
      },
      "notifications": [
        {
          "app": "string",
          "category": "string"
        }
      ],
      "calendar": [
        {
          "title": "string",
          "start": "ISO datetime",
          "end": "ISO datetime"
        }
      ]
    },
    "watch": {
      "heart_rate": "number (bpm)",
      "hrv": "number (ms)",
      "steps": "number",
      "sleep_hours": "number",
      "spo2": "number (blood oxygen %)",
      "stress_level": "string (low/medium/high)",
      "active_energy": "number (kcal)",
      "standing_hours": "number"
    },
    "laptop": {
      "active_window": "string (app name)",
      "screen_on": "boolean",
      "cpu_usage": "number (0-100)",
      "memory_usage": "number (0-100)",
      "battery_level": "number (0-100)",
      "battery_charging": "boolean",
      "wifi_ssid": "string",
      "media_playing": "string or null"
    }
  },
  "setup_instructions": [
    "1. Open Shortcuts app on iPhone",
    "2. Tap '+' to create a new shortcut",
    "3. Add 'Get Contents of URL' action",
    "4. Set URL to: https://your-host.your-tailnet.ts.net:8766/os/summon/text",
    "5. Set method to POST",
    "6. Add JSON body with 'transcript' key",
    "7. Add 'Show Result' action",
    "8. Name the shortcut 'Shadow Summon'",
    "9. Enable 'Show in Share Sheet' and 'Siri Shortcuts'",
    "10. Say 'Hey Siri, Shadow Summon' to invoke",
    "",
    "For HealthKit data push:",
    "11. Create an Automation in Shortcuts",
    "12. Set trigger: 'Health Sample' (heart rate, steps, etc.)",
    "13. Add 'Get Contents of URL' action",
    "14. Set URL to: https://your-host.your-tailnet.ts.net:8766/os/device/iphone",
    "15. Set method to POST",
    "16. Set body to JSON with device_id and health data",
    "17. Add X-API-Key header if authentication is enabled",
    "",
    "For Apple Watch data:",
    "18. Create a shortcut that reads Watch health metrics",
    "19. Push to: https://your-host.your-tailnet.ts.net:8766/os/device/watch",
    "20. Set device_id to 'apple_watch_siri'"
  ]
}