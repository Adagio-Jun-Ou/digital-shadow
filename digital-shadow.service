[Unit]
Description=Digital Shadow Daemon - Personal AI Assistant
After=network.target network-online.target

[Service]
Type=simple
User=your-user
Group=your-user
WorkingDirectory=/home/user/digital-shadow
EnvironmentFile=/home/user/digital-shadow/.env
Environment=SHADOW_DATA_DIR=/home/user/digital-shadow/data
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/digital-shadow/venv/bin/python -m shadowd.shadowd
Restart=on-failure
RestartSec=10
StartLimitBurst=5

# Security hardening (relaxed for home directory access)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target