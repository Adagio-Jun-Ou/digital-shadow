# Shadow AI Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# API Configuration
API_PORT=8765
SHADOW_PORT=8765
LOG_LEVEL=INFO

# Auth Configuration
SHADOW_AUTH_ENABLED=false
SHADOW_ADMIN_PASSWORD=changeme123
SHADOW_CORS_ORIGINS=http://localhost:3000,http://localhost:8765,http://127.0.0.1:8765

# Database Configuration
DB_PASSWORD=changeme_strong_password_here

# Redis Configuration
REDIS_MAXMEMORY=256mb

# LLM Configuration (REQUIRED - set your API key here)
LLM_PROVIDER=ollama_cloud
LLM_API_KEY=
LLM_API_BASE=https://ollama.com/v1
LLM_MODEL=glm-5

# Resource Limits
API_MEMORY_LIMIT=1G
API_MEMORY_RESERV=512M
API_CPU_LIMIT=1
API_CPU_RESERV=0.5

DB_MEMORY_LIMIT=512M
DB_CPU_LIMIT=0.5

REDIS_MEMORY_LIMIT=512M
REDIS_CPU_LIMIT=0.25

# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Loki Configuration
LOKI_PORT=3100

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=changeme_grafana_password_here
GRAFANA_URL=http://localhost:3000

# Traefik Configuration
TRAEFIK_DASHBOARD_PORT=8081
ACME_EMAIL=your-email@example.com
DOMAIN=localhost

# Network Configuration
NETWORK_SUBNET=172.28.0.0/16